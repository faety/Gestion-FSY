# Copier ce fichier vers .env et ajuster les valeurs.
# .env n'est jamais versionné : il contient des identifiants.

# Base PostgreSQL. Neon : console.neon.tech → projet → Connection string.
DATABASE_URL="postgresql://utilisateur:mot_de_passe@hote/base?sslmode=require"

# Secret utilisé pour signer les sessions.
# Générer une valeur aléatoire longue : openssl rand -base64 48
AUTH_SECRET="changez-moi"

# Stockage des photos de rapport (facultatif). Sans ces valeurs, les photos sont
# conservées dans la base — voir la section « Photos » du README.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Photos servies par lien libre au lieu d'une URL signée :
# CLOUDINARY_PHOTOS_PUBLIQUES="1"
