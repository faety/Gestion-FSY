// Schéma de données — Gestion FSY 2026 Abidjan Ouest

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles de la hiérarchie FSY :
// DIRIGEANT   = couple dirigeant (accès total, gestion des permissions)
// COORDINATEUR = coordinateur principal (accès complet, validations)
// ADJOINT     = coordinateur adjoint (dirige une compagnie, propose des modifications)
// CONSEILLER  = conseiller/conseillère (dirige un groupe, valide les cars)

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nom          String
  prenom       String
  telephone    String?
  sexe         String // "M" | "F"
  role         String // DIRIGEANT | COORDINATEUR | ADJOINT | CONSEILLER
  dateNaissance DateTime?
  // Présence à la conférence : un encadrant absent ne peut plus se connecter.
  actif        Boolean  @default(true)
  // Inscription en attente de validation par les coordinateurs principaux.
  // Les comptes créés par l'amorçage sont validés d'office ; ceux créés depuis
  // le formulaire d'inscription attendent une approbation.
  valide       Boolean  @default(true)
  // Mot de passe provisoire : la connexion aboutit, mais l'application impose
  // d'en choisir un nouveau avant toute autre action.
  doitChangerMotDePasse Boolean @default(false)
  // Permission supplémentaire accordée par le couple dirigeant (ex: droit de
  // modification directe du programme pour un adjoint)
  droitsSupplementaires String @default("[]") // JSON array d'actions

  // Photo de profil, déposée par la personne elle-même. Seul l'identifiant
  // Cloudinary est conservé ; l'image est servie par URL signée, comme les
  // photos de rapport. Soixante-quatre encadrants qui ne se connaissent pas
  // tous se repèrent plus vite avec un visage qu'avec un nom.
  photoPublicId String?

  // Design d'attestation choisi par la personne (CLASSIQUE | PRESTIGE_FR |
  // PRESTIGE_EN). Purement présentationnel : le code et le QR authentifient,
  // quel que soit l'habillage. C'est ce choix qui sort à l'impression du lot.
  modeleAttestation String @default("CLASSIQUE")

  pieu      Pieu?   @relation(fields: [pieuId], references: [id])
  pieuId    String?
  // Compagnie dirigée (pour les coordinateurs adjoints, par paire H/F)
  compagnie   Compagnie? @relation("DirigeantsCompagnie", fields: [compagnieId], references: [id])
  compagnieId String?

  groupesDiriges     Groupe[]
  affectationsCars   AffectationCar[]
  mouvementsValides  Mouvement[]
  cloturesCars       ClotureEtapeCar[] @relation("ClotureurCar")
  annoncesCreees     Annonce[]
  activitesCreees    Activite[]
  modifsProposees    ModificationProgramme[] @relation("Proposeur")
  modifsValidees     ModificationProgramme[] @relation("Valideur")
  rapports           RapportQuotidien[]
  attestation        Attestation?
  attestationsDelivrees Attestation[] @relation("Delivreur")
  reinitialisations  ReinitialisationMotDePasse[]
  auditLogs          AuditLog[]
  tachesPreparation  TachePreparation[]
  responsabilites    Responsabilite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pieu ou district de provenance des jeunes
model Pieu {
  id     String  @id @default(cuid())
  nom    String  @unique
  jeunes Jeune[]
  cars   Car[]
  users  User[]
}

// Compagnie : regroupement de groupes (garçons et filles), dirigée par une
// paire de coordinateurs adjoints (un homme et une femme, via User.compagnieId)
model Compagnie {
  id         String   @id @default(cuid())
  nom        String   @unique
  numero     Int?     @unique // numéro officiel de l'affectation (1 à 36)
  trancheAge String?
  groupes    Groupe[]
  dirigeants User[]   @relation("DirigeantsCompagnie")
  activites  Activite[]
}

// Groupe : jeunes du même sexe (~15-20), dirigé par un conseiller du même sexe
model Groupe {
  id           String  @id @default(cuid())
  nom          String  @unique
  sexe         String // "M" | "F"
  // Numéro du groupe au sein de sa compagnie (1 = filles, 2 = garçons)
  numeroDansCompagnie Int?
  trancheAge   String? // non utilisé : l'affectation officielle mélange les âges
  capaciteMax  Int     @default(20)
  conseiller   User?   @relation(fields: [conseillerId], references: [id])
  conseillerId String?
  compagnie    Compagnie? @relation(fields: [compagnieId], references: [id])
  compagnieId  String?
  jeunes       Jeune[]
  activites    ActiviteGroupe[]
}

model Jeune {
  id            String    @id @default(cuid())
  nom           String
  prenom        String
  nomUsage      String? // nom d'usage / surnom, utile à l'appel
  sexe          String // "M" | "F"
  dateNaissance DateTime?
  // Valeur brute conservée quand la date saisie est invalide (ex. « 0012-08-23 »),
  // pour que les coordinateurs puissent la corriger sans perdre l'information
  dateNaissanceBrute String?
  paroisse      String?
  tailleTshirt  String?
  // Approuvée | En attente d'approbation | Annulé(e) — les annulés ne sont pas
  // affectés à un groupe et n'apparaissent pas dans les listes de car
  statutInscription String @default("Approuvée")
  // Présence constatée à la main (arrivé par ses propres moyens, sans pointage
  // car). La présence réelle = pointage ARRIVEE OU cette coche — c'est elle
  // que lit la réorganisation du jour 1.
  presenceManuelle Boolean @default(false)
  // Données sensibles, importées séparément (voir scripts/importer-sensibles.ts)
  telephone     String?
  email         String?
  medical       String?
  alimentaire   String?
  contactNom    String?
  contactTelephone String?

  pieu       Pieu     @relation(fields: [pieuId], references: [id])
  pieuId     String
  groupe     Groupe?  @relation(fields: [groupeId], references: [id])
  groupeId   String?
  mouvements Mouvement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nom, prenom])
  @@index([dateNaissance])
}

// Car (bus) assigné à un pieu. Les personnes chargées de cocher les noms sont
// désignées étape par étape (voir AffectationCar).
model Car {
  id           String  @id @default(cuid())
  nom          String  @unique
  capacite     Int     @default(70)
  pieu         Pieu    @relation(fields: [pieuId], references: [id])
  pieuId       String
  mouvements   Mouvement[]
  affectations AffectationCar[]
  clotures     ClotureEtapeCar[]
}

// Qui coche les noms, pour un car et une étape donnés. Désigné par le couple
// dirigeant ou les coordinateurs principaux. Plusieurs personnes peuvent être
// affectées à une même étape sur un car chargé.
// etape: MONTEE (départ du pieu) | ARRIVEE (arrivée au site)
//        | DEPART (montée dans les cars le dernier jour, retour)
model AffectationCar {
  id     String @id @default(cuid())
  car    Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId  String
  etape  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([carId, etape, userId])
  @@index([userId])
}

// Clôture d'un pointage : le pointeur (ou un coordinateur) déclare l'étape
// terminée. Une ligne n'existe que pour une étape clôturée — tant qu'elle est
// absente, le pointage est ouvert. Après clôture, plus aucun mouvement n'est
// accepté sur cette étape ; seul un coordinateur peut la rouvrir (la ligne est
// alors supprimée, et la réouverture journalisée).
model ClotureEtapeCar {
  id           String   @id @default(cuid())
  car          Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId        String
  etape        String
  cloturePar   User     @relation("ClotureurCar", fields: [clotureParId], references: [id])
  clotureParId String
  clotureLe    DateTime @default(now())
  // Jeunes pointés au moment de la clôture : le résultat officiel de l'étape.
  pointes      Int

  @@unique([carId, etape])
}

// Mouvement : chaque validation d'arrivée/départ, horodatée
// type: MONTEE (monte dans le car au pieu) | ARRIVEE (descend au site) | DEPART (repart du site)
model Mouvement {
  id          String   @id @default(cuid())
  type        String
  jeune       Jeune    @relation(fields: [jeuneId], references: [id], onDelete: Cascade)
  jeuneId     String
  car         Car      @relation(fields: [carId], references: [id])
  carId       String
  validePar   User     @relation(fields: [valideParId], references: [id])
  valideParId String
  horodatage  DateTime @default(now())

  @@index([jeuneId, type])
  @@index([carId, horodatage])
}

// Journée de la conférence (0 = veille, réservée aux encadrants ; 1 à 6 = conférence)
// Les tenues des participants et des encadrants diffèrent selon les jours.
model JourneeConference {
  id              String   @id @default(cuid())
  numero          Int      @unique
  date            DateTime
  tenue           String? // tenue des participants
  tenueEncadrants String?
  note            String?
}

// Activité du programme
// type: GENERAL       (tout le monde ensemble)
//       PAR_GROUPE    (chaque groupe séparément, avec son conseiller)
//       PAR_COMPAGNIE (chaque compagnie séparément)
//       COMPAGNIE     (une compagnie précise, via compagnieId)
//       GROUPE | MULTI_GROUPE (groupes précis, via ActiviteGroupe)
// statut: PLANIFIE (officiel, manuel du participant FSY 2026)
//         | A_CONFIRMER (horaire provisoire, à valider par les coordinateurs)
//         | MODIFIE | ANNULE
// publicCible: TOUS | GARCONS | FILLES (ex. jour 4, réunions spirituelles et
//              activités séparées Jeunes Gens / Jeunes Filles)
model Activite {
  id          String   @id @default(cuid())
  // Vient du programme officiel des manuels : une remise à zéro après les essais
  // efface les activités ajoutées à la main, jamais celles-ci.
  officielle  Boolean  @default(false)
  titre       String
  description String?
  debut       DateTime
  fin         DateTime?
  lieu        String?
  type        String   @default("GENERAL")
  statut      String   @default("PLANIFIE")
  publicCible String   @default("TOUS")
  // Réunion réservée aux encadrants (les jeunes n'y participent pas)
  pourEncadrants Boolean @default(false)
  // Rôle attendu de chaque niveau, d'après le manuel de l'encadrant :
  // DIRIGER | ENSEIGNER | SUPERVISER | AIDER | ASSISTER | RECEVOIR
  // | FACULTATIF (assister si souhaité) | SI_ATTRIBUE (si la tâche est attribuée)
  // | AUCUN (ne concerne pas ce niveau)
  roleConseiller   String @default("ASSISTER")
  roleAdjoint      String @default("ASSISTER")
  roleCoordinateur String @default("ASSISTER")
  roleDirigeant    String @default("FACULTATIF")
  compagnie   Compagnie? @relation(fields: [compagnieId], references: [id])
  compagnieId String?
  groupes     ActiviteGroupe[]
  creePar     User?    @relation(fields: [creeParId], references: [id])
  creeParId   String?
  modifications ModificationProgramme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([debut])
}

model ActiviteGroupe {
  activite   Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  activiteId String
  groupe     Groupe   @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  groupeId   String

  @@id([activiteId, groupeId])
}

// Proposition de modification du programme (workflow de validation)
// statut: PROPOSE | VALIDE | REJETE
model ModificationProgramme {
  id           String   @id @default(cuid())
  activite     Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  activiteId   String
  // Champs proposés (null = inchangé)
  nouveauTitre String?
  nouveauDebut DateTime?
  nouvelleFin  DateTime?
  nouveauLieu  String?
  nouveauStatut String? // ex: ANNULE
  motif        String?
  statut       String   @default("PROPOSE")
  proposePar   User     @relation("Proposeur", fields: [proposeParId], references: [id])
  proposeParId String
  validePar    User?    @relation("Valideur", fields: [valideParId], references: [id])
  valideParId  String?
  createdAt    DateTime @default(now())
  decideAt     DateTime?
}

// Annonce ciblée par rôle
// cible: TOUS | COORDINATEURS | ADJOINTS | CONSEILLERS
model Annonce {
  id        String   @id @default(cuid())
  titre     String
  contenu   String
  cible     String   @default("TOUS")
  // Date de publication : une annonce programmée dans le futur reste invisible
  // jusqu'à cette date (les coordinateurs voient la file des annonces à venir).
  datePublication DateTime @default(now())
  // Annonce générée automatiquement (anniversaires) : repérable et régénérable
  automatique Boolean @default(false)
  creePar   User     @relation(fields: [creeParId], references: [id])
  creeParId String
  createdAt DateTime @default(now())

  @@index([datePublication])
}

// Rapport quotidien d'un encadrant, une fois par journée de conférence.
// Les réponses aux questions du modèle (src/lib/rapports.ts) sont stockées en
// JSON : le questionnaire évolue d'une année à l'autre sans migration de schéma.
model RapportQuotidien {
  id       String @id @default(cuid())
  auteur   User   @relation(fields: [auteurId], references: [id])
  auteurId String
  jour     Int // numéro de journée de conférence (0 = veille, 1 à 6)
  date     DateTime

  ambiance   String // EXCELLENTE | BONNE | CORRECTE | DIFFICILE | CRITIQUE
  reponses   String @default("{}") // JSON { idQuestion: valeur }
  aMarche    String @default("")
  aAmeliorer String @default("")
  // Demande d'aide : remonte en tête du tableau de bord des coordinateurs
  besoinAide Boolean @default(false)
  detailAide String?

  points Int @default(0)
  photos PhotoRapport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auteurId, jour])
  @@index([jour])
}

// Photo jointe à un rapport.
//
// Deux modes, selon que Cloudinary est configuré ou non :
//   - publicId renseigné : la photo est chez Cloudinary, qui produit la taille
//     demandée à la volée (vignette pour la synthèse, image entière à l'appui) ;
//   - image renseigné : ancien mode, la photo est conservée en data URL dans la
//     base. Les photos déjà envoyées de cette façon restent lisibles.
model PhotoRapport {
  id        String           @id @default(cuid())
  rapport   RapportQuotidien @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  rapportId String
  publicId  String?
  largeur   Int?
  hauteur   Int?
  image     String?
  legende   String?
}

// Attestation d'encadrement remise à la fin de la conférence.
//
// Les faits sont figés au moment de la délivrance : une attestation ne doit pas
// changer si les données évoluent ensuite. C'est ce qui permet à un employeur de
// s'y fier, et à la page de vérification de dire la même chose des mois après.
model Attestation {
  id     String @id @default(cuid())
  // Code de vérification imprimé sur le document, du type A7K2-9M4X
  code   String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  role    String // rôle exercé, tel qu'il était à la délivrance
  mention String? // RIGUEUR | EXCELLENCE — absente si le seuil n'est pas atteint
  faits   String // JSON figé : groupes encadrés, effectifs, rapports remis…

  delivreePar   User   @relation("Delivreur", fields: [delivreeParId], references: [id])
  delivreeParId String
  delivreeLe    DateTime @default(now())

  // Une attestation délivrée par erreur est révoquée, jamais effacée : la page
  // de vérification doit pouvoir répondre « ce document n'est plus valable ».
  revoqueeLe      DateTime?
  motifRevocation String?
}

// Demande de réinitialisation de mot de passe.
//
// Le jeton n'est jamais conservé en clair : seule son empreinte SHA-256 est
// enregistrée. Quelqu'un qui lirait la base ne pourrait donc pas s'en servir
// pour prendre la main sur un compte — il lui manquerait la valeur d'origine,
// qui n'existe que dans le lien envoyé par e-mail.
model ReinitialisationMotDePasse {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  empreinte String   @unique
  expireLe  DateTime
  // Horodatée à l'emploi : un lien ne sert qu'une fois, et l'on garde la trace
  // plutôt que d'effacer, pour pouvoir enquêter après coup.
  utiliseLe DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Tentatives de connexion, pour freiner les essais en série.
//
// Les comptes d'amorçage partagent un mot de passe initial, et les adresses se
// devinent à partir des noms : sans limitation, essayer une centaine de
// combinaisons ne coûte rien. On ne bloque pas le compte — ce serait un moyen
// commode d'empêcher quelqu'un de travailler — on ralentit l'adresse visée.
model TentativeConnexion {
  id        String   @id @default(cuid())
  email     String
  reussie   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Photobooth : les selfies souvenirs pris sur l'iPad de l'événement, avec un
// cadre FSY. Cloudinary quand il est configuré (publicId), repli en base
// sinon (image, réduite). Des mineurs y figurent : livraison signée, galerie
// réservée à la direction.
model PhotoSouvenir {
  id         String   @id @default(cuid())
  publicId   String?
  image      String?
  cadre      String
  creeLe     DateTime @default(now())
  priseParId String?
}

// Photographie de l'organisation (groupes, compagnies, affectations) prise
// juste avant qu'une réorganisation automatique ne s'applique : le bouton
// « Revenir à l'état d'avant » restaure ce contenu tel quel. Les données sont
// un JSON autoportant — aucune clé étrangère, pour que la restauration reste
// possible quoi qu'il arrive entre-temps.
model InstantaneOrganisation {
  id        String   @id @default(cuid())
  motif     String
  donnees   String
  creeLe    DateTime @default(now())
  creeParId String
}

// Journal des vérifications d'attestations : chaque scan (ou saisie) sur la
// page publique est consigné. Le public voit le compteur et la date de la
// première vérification — un faux statique ne vit pas ; le couple dirigeant
// voit le journal complet et repère les anomalies.
model ScanVerification {
  id        String   @id @default(cuid())
  // Le code demandé, tel que saisi (normalisé), qu'il existe ou non.
  code      String
  connu     Boolean
  createdAt DateTime @default(now())

  @@index([code, createdAt])
}

// Signature manuscrite de chacun des deux membres du couple dirigeant, tracée
// au doigt ou au stylet dans l'application, une seule fois. Elle s'appose sur
// toutes les VRAIES attestations ; le spécimen garde sa signature de police.
// Clé = nom du signataire tel que dans SIGNATAIRES (lib/attestations).
model SignatureDirigeant {
  nom          String   @id
  // PNG en data URL, fond transparent, tracé sombre. Petite (< 200 Ko).
  image        String
  misAJourLe   DateTime @updatedAt
  misAJourParId String?
}

// Jalon du calendrier de préparation, tel que le fixe le guide de planification.
//
// Seul l'état est en base : l'intitulé, l'échéance et le responsable viennent
// de src/lib/guide.ts, qui transcrit le guide. Une ligne n'existe que lorsque
// quelqu'un a coché ou annoté — un calendrier vierge ne pèse rien.
model TachePreparation {
  id  String @id @default(cuid())
  cle String @unique

  faite    Boolean   @default(false)
  faitLe   DateTime?
  faitPar  User?     @relation(fields: [faitParId], references: [id])
  faitParId String?
  note     String?

  updatedAt DateTime @updatedAt
}

// Responsabilité du comité logistique, confiée nominativement.
//
// La personne n'a pas forcément de compte : l'administrateur des repas peut
// être le gestionnaire de la cafétéria du site. On garde donc un nom et un
// téléphone libres, et un lien vers un compte quand il existe.
model Responsabilite {
  id  String @id @default(cuid())
  cle String @unique

  user      User?   @relation(fields: [userId], references: [id])
  userId    String?
  nom       String?
  telephone String?
  note      String?

  updatedAt DateTime @updatedAt
}

// Journal d'audit : qui a fait quoi, à quelle heure
model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
