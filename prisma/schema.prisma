// Schéma de données — Gestion FSY 2026 Abidjan Ouest

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles de la hiérarchie FSY :
// DIRIGEANT   = couple dirigeant (accès total, gestion des permissions)
// COORDINATEUR = coordinateur principal (accès complet, validations)
// ADJOINT     = coordinateur adjoint (dirige une compagnie, propose des modifications)
// CONSEILLER  = conseiller/conseillère (dirige un groupe, valide les cars)

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nom          String
  prenom       String
  telephone    String?
  sexe         String // "M" | "F"
  role         String // DIRIGEANT | COORDINATEUR | ADJOINT | CONSEILLER
  dateNaissance DateTime?
  // Présence à la conférence : un encadrant absent ne peut plus se connecter.
  actif        Boolean  @default(true)
  // Inscription en attente de validation par les coordinateurs principaux.
  // Les comptes créés par l'amorçage sont validés d'office ; ceux créés depuis
  // le formulaire d'inscription attendent une approbation.
  valide       Boolean  @default(true)
  // Mot de passe provisoire : la connexion aboutit, mais l'application impose
  // d'en choisir un nouveau avant toute autre action.
  doitChangerMotDePasse Boolean @default(false)
  // Permission supplémentaire accordée par le couple dirigeant (ex: droit de
  // modification directe du programme pour un adjoint)
  droitsSupplementaires String @default("[]") // JSON array d'actions

  pieu      Pieu?   @relation(fields: [pieuId], references: [id])
  pieuId    String?
  // Compagnie dirigée (pour les coordinateurs adjoints, par paire H/F)
  compagnie   Compagnie? @relation("DirigeantsCompagnie", fields: [compagnieId], references: [id])
  compagnieId String?

  groupesDiriges     Groupe[]
  affectationsCars   AffectationCar[]
  mouvementsValides  Mouvement[]
  annoncesCreees     Annonce[]
  activitesCreees    Activite[]
  modifsProposees    ModificationProgramme[] @relation("Proposeur")
  modifsValidees     ModificationProgramme[] @relation("Valideur")
  rapports           RapportQuotidien[]
  auditLogs          AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pieu ou district de provenance des jeunes
model Pieu {
  id     String  @id @default(cuid())
  nom    String  @unique
  jeunes Jeune[]
  cars   Car[]
  users  User[]
}

// Compagnie : regroupement de groupes (garçons et filles), dirigée par une
// paire de coordinateurs adjoints (un homme et une femme, via User.compagnieId)
model Compagnie {
  id         String   @id @default(cuid())
  nom        String   @unique
  numero     Int?     @unique // numéro officiel de l'affectation (1 à 36)
  trancheAge String?
  groupes    Groupe[]
  dirigeants User[]   @relation("DirigeantsCompagnie")
  activites  Activite[]
}

// Groupe : jeunes du même sexe (~15-20), dirigé par un conseiller du même sexe
model Groupe {
  id           String  @id @default(cuid())
  nom          String  @unique
  sexe         String // "M" | "F"
  // Numéro du groupe au sein de sa compagnie (1 = filles, 2 = garçons)
  numeroDansCompagnie Int?
  trancheAge   String? // non utilisé : l'affectation officielle mélange les âges
  capaciteMax  Int     @default(20)
  conseiller   User?   @relation(fields: [conseillerId], references: [id])
  conseillerId String?
  compagnie    Compagnie? @relation(fields: [compagnieId], references: [id])
  compagnieId  String?
  jeunes       Jeune[]
  activites    ActiviteGroupe[]
}

model Jeune {
  id            String    @id @default(cuid())
  nom           String
  prenom        String
  nomUsage      String? // nom d'usage / surnom, utile à l'appel
  sexe          String // "M" | "F"
  dateNaissance DateTime?
  // Valeur brute conservée quand la date saisie est invalide (ex. « 0012-08-23 »),
  // pour que les coordinateurs puissent la corriger sans perdre l'information
  dateNaissanceBrute String?
  paroisse      String?
  tailleTshirt  String?
  // Approuvée | En attente d'approbation | Annulé(e) — les annulés ne sont pas
  // affectés à un groupe et n'apparaissent pas dans les listes de car
  statutInscription String @default("Approuvée")
  // Données sensibles, importées séparément (voir scripts/importer-sensibles.ts)
  telephone     String?
  email         String?
  medical       String?
  alimentaire   String?
  contactNom    String?
  contactTelephone String?

  pieu       Pieu     @relation(fields: [pieuId], references: [id])
  pieuId     String
  groupe     Groupe?  @relation(fields: [groupeId], references: [id])
  groupeId   String?
  mouvements Mouvement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nom, prenom])
  @@index([dateNaissance])
}

// Car (bus) assigné à un pieu. Les personnes chargées de cocher les noms sont
// désignées étape par étape (voir AffectationCar).
model Car {
  id           String  @id @default(cuid())
  nom          String  @unique
  capacite     Int     @default(70)
  pieu         Pieu    @relation(fields: [pieuId], references: [id])
  pieuId       String
  mouvements   Mouvement[]
  affectations AffectationCar[]
}

// Qui coche les noms, pour un car et une étape donnés. Désigné par le couple
// dirigeant ou les coordinateurs principaux. Plusieurs personnes peuvent être
// affectées à une même étape sur un car chargé.
// etape: MONTEE (départ du pieu) | ARRIVEE (arrivée au site)
//        | DEPART (montée dans les cars le dernier jour, retour)
model AffectationCar {
  id     String @id @default(cuid())
  car    Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId  String
  etape  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([carId, etape, userId])
  @@index([userId])
}

// Mouvement : chaque validation d'arrivée/départ, horodatée
// type: MONTEE (monte dans le car au pieu) | ARRIVEE (descend au site) | DEPART (repart du site)
model Mouvement {
  id          String   @id @default(cuid())
  type        String
  jeune       Jeune    @relation(fields: [jeuneId], references: [id], onDelete: Cascade)
  jeuneId     String
  car         Car      @relation(fields: [carId], references: [id])
  carId       String
  validePar   User     @relation(fields: [valideParId], references: [id])
  valideParId String
  horodatage  DateTime @default(now())

  @@index([jeuneId, type])
  @@index([carId, horodatage])
}

// Journée de la conférence (0 = veille, réservée aux encadrants ; 1 à 6 = conférence)
// Les tenues des participants et des encadrants diffèrent selon les jours.
model JourneeConference {
  id              String   @id @default(cuid())
  numero          Int      @unique
  date            DateTime
  tenue           String? // tenue des participants
  tenueEncadrants String?
  note            String?
}

// Activité du programme
// type: GENERAL       (tout le monde ensemble)
//       PAR_GROUPE    (chaque groupe séparément, avec son conseiller)
//       PAR_COMPAGNIE (chaque compagnie séparément)
//       COMPAGNIE     (une compagnie précise, via compagnieId)
//       GROUPE | MULTI_GROUPE (groupes précis, via ActiviteGroupe)
// statut: PLANIFIE (officiel, manuel du participant FSY 2026)
//         | A_CONFIRMER (horaire provisoire, à valider par les coordinateurs)
//         | MODIFIE | ANNULE
// publicCible: TOUS | GARCONS | FILLES (ex. jour 4, réunions spirituelles et
//              activités séparées Jeunes Gens / Jeunes Filles)
model Activite {
  id          String   @id @default(cuid())
  // Vient du programme officiel des manuels : une remise à zéro après les essais
  // efface les activités ajoutées à la main, jamais celles-ci.
  officielle  Boolean  @default(false)
  titre       String
  description String?
  debut       DateTime
  fin         DateTime?
  lieu        String?
  type        String   @default("GENERAL")
  statut      String   @default("PLANIFIE")
  publicCible String   @default("TOUS")
  // Réunion réservée aux encadrants (les jeunes n'y participent pas)
  pourEncadrants Boolean @default(false)
  // Rôle attendu de chaque niveau, d'après le manuel de l'encadrant :
  // DIRIGER | ENSEIGNER | SUPERVISER | AIDER | ASSISTER | RECEVOIR
  // | FACULTATIF (assister si souhaité) | SI_ATTRIBUE (si la tâche est attribuée)
  // | AUCUN (ne concerne pas ce niveau)
  roleConseiller   String @default("ASSISTER")
  roleAdjoint      String @default("ASSISTER")
  roleCoordinateur String @default("ASSISTER")
  roleDirigeant    String @default("FACULTATIF")
  compagnie   Compagnie? @relation(fields: [compagnieId], references: [id])
  compagnieId String?
  groupes     ActiviteGroupe[]
  creePar     User?    @relation(fields: [creeParId], references: [id])
  creeParId   String?
  modifications ModificationProgramme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([debut])
}

model ActiviteGroupe {
  activite   Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  activiteId String
  groupe     Groupe   @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  groupeId   String

  @@id([activiteId, groupeId])
}

// Proposition de modification du programme (workflow de validation)
// statut: PROPOSE | VALIDE | REJETE
model ModificationProgramme {
  id           String   @id @default(cuid())
  activite     Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)
  activiteId   String
  // Champs proposés (null = inchangé)
  nouveauTitre String?
  nouveauDebut DateTime?
  nouveauLieu  String?
  nouveauStatut String? // ex: ANNULE
  motif        String?
  statut       String   @default("PROPOSE")
  proposePar   User     @relation("Proposeur", fields: [proposeParId], references: [id])
  proposeParId String
  validePar    User?    @relation("Valideur", fields: [valideParId], references: [id])
  valideParId  String?
  createdAt    DateTime @default(now())
  decideAt     DateTime?
}

// Annonce ciblée par rôle
// cible: TOUS | COORDINATEURS | ADJOINTS | CONSEILLERS
model Annonce {
  id        String   @id @default(cuid())
  titre     String
  contenu   String
  cible     String   @default("TOUS")
  // Date de publication : une annonce programmée dans le futur reste invisible
  // jusqu'à cette date (les coordinateurs voient la file des annonces à venir).
  datePublication DateTime @default(now())
  // Annonce générée automatiquement (anniversaires) : repérable et régénérable
  automatique Boolean @default(false)
  creePar   User     @relation(fields: [creeParId], references: [id])
  creeParId String
  createdAt DateTime @default(now())

  @@index([datePublication])
}

// Rapport quotidien d'un encadrant, une fois par journée de conférence.
// Les réponses aux questions du modèle (src/lib/rapports.ts) sont stockées en
// JSON : le questionnaire évolue d'une année à l'autre sans migration de schéma.
model RapportQuotidien {
  id       String @id @default(cuid())
  auteur   User   @relation(fields: [auteurId], references: [id])
  auteurId String
  jour     Int // numéro de journée de conférence (0 = veille, 1 à 6)
  date     DateTime

  ambiance   String // EXCELLENTE | BONNE | CORRECTE | DIFFICILE | CRITIQUE
  reponses   String @default("{}") // JSON { idQuestion: valeur }
  aMarche    String @default("")
  aAmeliorer String @default("")
  // Demande d'aide : remonte en tête du tableau de bord des coordinateurs
  besoinAide Boolean @default(false)
  detailAide String?

  points Int @default(0)
  photos PhotoRapport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auteurId, jour])
  @@index([jour])
}

// Photo jointe à un rapport.
//
// Deux modes, selon que Cloudinary est configuré ou non :
//   - publicId renseigné : la photo est chez Cloudinary, qui produit la taille
//     demandée à la volée (vignette pour la synthèse, image entière à l'appui) ;
//   - image renseigné : ancien mode, la photo est conservée en data URL dans la
//     base. Les photos déjà envoyées de cette façon restent lisibles.
model PhotoRapport {
  id        String           @id @default(cuid())
  rapport   RapportQuotidien @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  rapportId String
  publicId  String?
  largeur   Int?
  hauteur   Int?
  image     String?
  legende   String?
}

// Journal d'audit : qui a fait quoi, à quelle heure
model AuditLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
