# Copier ce fichier vers .env et remplir. .env n'est jamais versionné.
#
# Sur Vercel, chaque variable se déclare dans Settings → Environment Variables,
# puis il faut REDÉPLOYER : un déploiement fait avant l'ajout ne la voit pas.
# Ne jamais mettre de guillemets dans les valeurs saisies chez Vercel.

# ---------- Base de données (PostgreSQL) ----------
# Neon : console.neon.tech → projet → « Connection string » (pooled ou non,
# les deux marchent ; src/lib/db.ts ajoute lui-même connection_limit=1 sur Vercel).
# En local : voir scripts/postgres-local.sh
DATABASE_URL="postgresql://utilisateur:mot_de_passe@hote/base?sslmode=require"

# ---------- Sessions ----------
# Obligatoire en production, 24 caractères au minimum. Générer :
#   openssl rand -base64 48
AUTH_SECRET="changez-moi"

# ---------- Adresse publique ----------
# Imprimée dans les e-mails, les QR et les documents : un nom qui résout vraiment.
SITE_URL="http://localhost:3000"

# ---------- Premier compte administrateur (amorçage) ----------
# Créé par prisma/seed.ts s'il n'existe pas encore. Le mot de passe est
# provisoire : l'application impose d'en choisir un autre à la première connexion.
SEED_ADMIN_EMAIL="admin@exemple.ci"
SEED_ADMIN_MOT_DE_PASSE="changez-moi-vite"
SEED_ADMIN_PRENOM="Prénom"
SEED_ADMIN_NOM="Nom"

# ---------- Cloudinary (facultatif) ----------
# Sans ces valeurs, l'envoi de photos est simplement désactivé, rien ne casse.
# cloudinary.com → Dashboard → API Keys.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Photos servies par lien libre au lieu d'une URL signée (par défaut : signée) :
# CLOUDINARY_PHOTOS_PUBLIQUES="1"

# ---------- E-mails par Resend (facultatif) ----------
# Sans clef, les fonctions renvoient « non envoyé » et l'application propose
# une solution de repli (mot de passe provisoire dicté par un administrateur).
# resend.com → API Keys ; le domaine de l'expéditeur doit être vérifié chez Resend.
# RESEND_API_KEY=""
# EMAIL_EXPEDITEUR="bonjour@exemple.ci"
# EMAIL_NOM="Mon application"
